VITE_SUPABASE_ANON_KEY=your-anon-key

# ===== Server only (Vercel → Settings → Environment Variables) =====
# NEVER put these in code or in a VITE_ variable
RESEND_API_KEY=re_xxxxxxxx
# Who receives contact-form messages (comma separated)
CONTACT_TO=mostafashawgi@gmail.com
# After verifying moshaltd.com in Resend, set this so mail goes to any address and customers get a confirmation
RESEND_FROM=Mosha Website <no-reply@moshaltd.com>
# Used by /api/send-email to save messages and rate-limit spam
SUPABASE_URL=https://mqklhyqprouooifigdyq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Extra allowed origins for the contact API (comma separated). moshaltd.com, *.vercel.app and localhost are allowed by default.
ALLOWED_ORIGINS=
